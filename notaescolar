algoritmo "NotaEscolar"

var
 nome: caractere
 op: caractere
 nota1, nota2, nota3, nota4: real
 media: real

inicio
repita
  escreval("Informe o nome do aluno: ")
  leia(nome)
  escreval("Informar a primeira nota: ")
  leia(nota1)
  escreval("Informar a segunda nota: ")
  leia(nota2)
  escreval("Informar a terceira nota: ")
  leia(nota3)
  escreval("Informar a quarta nota: ")
  leia(nota4)

media <- (nota1 + nota2 + nota3 + nota4) / 4
escreval("Nome do aluno: ")
escreval(nome)
escreval("Media final: ")
escreval(media)
escreval("Deseja continuar? (S/N): ")
leia(op)
ate((op = "N") ou (op = "n"))
fimalgoritmo